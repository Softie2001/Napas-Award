{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "napas-payment-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "napas-voting-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
