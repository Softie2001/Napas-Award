rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // CONTESTANTS
    // Public voters can ONLY read published contestants.
    // Admin can manage contestants when authenticated.
    // =========================================================
    match /contestants/{contestantId} {

      // Public voter access
      allow read: if resource.data.published == true;

      // Admin access
      allow create, update, delete:
        if request.auth != null
        && request.auth.token.email == "quadrisubomi@gmail.com";
    }


    // =========================================================
    // VOTING SETTINGS
    // Public voters need to read the current voting status
    // and price.
    // Only the admin can change these settings.
    // =========================================================
    match /settings/{settingId} {

      allow read: if settingId == "voting";

      allow create, update, delete:
        if request.auth != null
        && request.auth.token.email == "quadrisubomi@gmail.com";
    }


    // =========================================================
    // ADMIN ACTIVITY
    // Only the authenticated admin can read/write activity logs.
    // =========================================================
    match /adminActivity/{activityId} {

      allow read, write:
        if request.auth != null
        && request.auth.token.email == "quadrisubomi@gmail.com";
    }


    // =========================================================
    // EVERYTHING ELSE
    // Deny by default.
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
